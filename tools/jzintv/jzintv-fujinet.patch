+    /*  go with them -- the next cart's own calls re-register whatever it      */
+    /*  actually needs snooped.                                               */
+    /* ---------------------------------------------------------------------- */
+    periph_unregister(cp1600->periph.bus, &cp1600->snoop);
+}
