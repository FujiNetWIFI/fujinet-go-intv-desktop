+OBJS += fujinet/fujibus.$(O) fujinet/fn_sock.$(O) fujinet/fujinet.$(O)
+OBJS += fujinet/fujinet_config_rom.$(O)
+
+##############################################################################
+## Regenerate fujinet/fujinet_config_rom.{c,h} from fujinet-config/intv's
+## config.rom build artifact.  Not part of the default build -- run by hand
+## after rebuilding config.rom, and only if you have the fujinet-config repo
+## checked out.  FUJINET_CONFIG_ROM should point at its intv/config.rom.
+##############################################################################
+FUJINET_CONFIG_ROM ?= ../../fujinet-config/intv/config.rom
